# ============================================================
# RunarForge Environment Variables
# Copy this file to .env for local development
# NEVER commit .env — it is gitignored
# ============================================================

# ------------------------------------------------------------
# Storage Selection
# ------------------------------------------------------------
# Which storage backend to use
# Options: postgresql | sqlite
RUNAR_STORAGE=postgresql

# ------------------------------------------------------------
# PostgreSQL (used when RUNAR_STORAGE=postgresql)
# ------------------------------------------------------------
POSTGRES_PASSWORD=runar_password
RUNAR_DB_URL=postgresql://runar:runar_password@localhost:5432/runar_memory
RUNAR_DB_POOL_MIN=2
RUNAR_DB_POOL_MAX=10

# ------------------------------------------------------------
# SQLite (used when RUNAR_STORAGE=sqlite)
# ------------------------------------------------------------
# Absolute path to SQLite database file
RUNAR_SQLITE_PATH=~/.runar-forge/memory.db

# ------------------------------------------------------------
# Memory Configuration
# ------------------------------------------------------------
# Namespace isolates memory per team, project, or environment
RUNAR_MEMORY_NAMESPACE=default

# Dimension count must match your embedding model output
#   384  for local (all-MiniLM-L6-v2)
#   1536 for openai (text-embedding-3-small)
RUNAR_VECTOR_DIMENSIONS=384

# ------------------------------------------------------------
# MCP Server
# ------------------------------------------------------------
# Transport: stdio (recommended) | http
RUNAR_MCP_TRANSPORT=stdio
# Port used only when RUNAR_MCP_TRANSPORT=http
RUNAR_MCP_PORT=3100

# ------------------------------------------------------------
# Web UI (Phase 3+)
# ------------------------------------------------------------
RUNAR_UI_PORT=3000
# Simple token for UI authentication (generate a strong random string)
RUNAR_UI_AUTH_TOKEN=replace_with_strong_random_token

# ------------------------------------------------------------
# GitLab Package Registry
# ------------------------------------------------------------
# Scoped to: read_package_registry + write_package_registry
# Generate at: GitLab → User Settings → Access Tokens
GITLAB_TOKEN=

# ------------------------------------------------------------
# Embeddings Configuration
# ------------------------------------------------------------
# Controls semantic vector search quality
#
# disabled (default) — keyword search only, zero setup
#   Good for: all developers, CI/CD, quick setup
#
# local — @xenova/transformers model runs on CPU
#   Good for: M1/M2 Macs, IONOS server, testing
#   Requires: ~25MB model download on first use, ~90MB RAM
#   Vector dimensions: 384
#
# openai — OpenAI text-embedding-3-small via API
#   Good for: teams wanting highest accuracy
#   Requires: OPENAI_API_KEY
#   Vector dimensions: 1536
#
RUNAR_EMBEDDINGS=disabled

# Required only when RUNAR_EMBEDDINGS=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------
# Capture & Hooks
# ------------------------------------------------------------
# Persist genuine typed user prompts as user-prompt entries (secret patterns
# are redacted; machine-generated payloads are filtered out).
RUNAR_SAVE_PROMPTS=true

# Rule-based passive extraction from tool output (bugs, decisions, new files).
RUNAR_PASSIVE_LEARNING=true

# Auto-capture queue hooks (enqueue + SessionEnd summarize). Written by
# `runar setup` so re-runs preserve the choice; `--no-auto-capture` sets false.
RUNAR_AUTO_CAPTURE=true

# Session summarizer backend: with ANTHROPIC_API_KEY set, SessionEnd
# summaries are written by claude-haiku; otherwise a local heuristic runs.
# ANTHROPIC_API_KEY=sk-ant-...

# Per-hook wall-clock budget in milliseconds (summarize gets 4x).
RUNAR_HOOK_BUDGET_MS=800

# Global hook kill switch (or touch ~/.runar-forge/.disable-hooks).
# RUNAR_DISABLE_HOOKS=true

# ------------------------------------------------------------
# Telemetry & GC
# ------------------------------------------------------------
# Record debug_log events (injection, search scoring, touch, hook timing);
# read them via the muninn_debug MCP tool. Off by default.
# RUNAR_DEBUG=true

# Age (days) past which never-accessed ARCHIVAL entries become evictable.
# RUNAR_TIER_EVICTION_AGE_DAYS=90

# ------------------------------------------------------------
# Development
# ------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
